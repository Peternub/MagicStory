[Unit]
Description=Веб-приложение SkazKIDS
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=skazkids
Group=skazkids
WorkingDirectory=/opt/skazkids
Environment=NODE_ENV=production
EnvironmentFile=/etc/skazkids/app.env
EnvironmentFile=/etc/skazkids/database.env
EnvironmentFile=/etc/skazkids/ai-gateway.env
ExecStart=/usr/local/bin/bun run start --hostname 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0027

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
