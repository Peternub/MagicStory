ANALYTICS_DATABASE_URL=postgresql://skazkids_analytics:CHANGE_ME@127.0.0.1:5432/skazkids
ANALYTICS_TIMEZONE=Europe/Moscow
ANALYTICS_BASELINE_DAYS=7
ANALYTICS_MIN_RETENTION_SAMPLE=10

TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_REPORT_CHAT_IDS=

ANALYTICS_AI_ENABLED=true
ANALYTICS_AI_MODEL=gpt-5.6-terra
AI_GATEWAY_URL=https://CHANGE_ME
AI_GATEWAY_CA_FILE=/etc/skazkids/certs/ai-gateway-ca.crt

BACKEND_HEALTH_URL=http://127.0.0.1:3000/api/health
AI_GATEWAY_HEALTH_URL=https://CHANGE_ME/health
ANALYTICS_BACKUP_DIRECTORY=/var/backups/skazkids/postgresql
ANALYTICS_DISK_PATH=/opt/skazkids
ANALYTICS_PRODUCTION_SERVICE=skazkids.service
ANALYTICS_NGINX_SERVICE=nginx.service
ANALYTICS_AI_GATEWAY_SERVICE=skazkids-ai-gateway.service

ANALYTICS_ALERT_COOLDOWN_MINUTES=360
ANALYTICS_AI_ERROR_WARNING_PERCENT=5
ANALYTICS_AI_ERROR_CRITICAL_PERCENT=10
ANALYTICS_AI_MIN_REQUESTS=10
ANALYTICS_REGISTRATION_CHANGE_PERCENT=30
ANALYTICS_REGISTRATION_MINIMUM=5
ANALYTICS_BACKUP_WARNING_HOURS=30
ANALYTICS_BACKUP_CRITICAL_HOURS=48
ANALYTICS_DISK_WARNING_PERCENT=75
ANALYTICS_DISK_CRITICAL_PERCENT=90
