[Unit]
Description=Telegram-команды SkazKIDS Analytics
After=network-online.target postgresql.service skazkids.service
Wants=network-online.target

[Service]
Type=simple
User=skazkids-analytics
Group=skazkids-analytics
WorkingDirectory=/opt/skazkids
Environment=NODE_ENV=production
EnvironmentFile=/etc/skazkids/analytics.env
EnvironmentFile=-/etc/skazkids/ai-gateway.env
ExecStart=/usr/local/bin/bun run analytics:bot
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0077

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
