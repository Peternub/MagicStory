[Unit]
Description=Веб-приложение MagicStory
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=magicstory
Group=magicstory
WorkingDirectory=/opt/magicstory
Environment=NODE_ENV=production
EnvironmentFile=/etc/magicstory/app.env
EnvironmentFile=/etc/magicstory/database.env
ExecStart=/usr/local/bin/bun run start --hostname 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0027

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
