#!/usr/bin/env bash
set -Eeuo pipefail

backup_dir="/var/backups/skazkids/postgresql"
timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
archive_path="${backup_dir}/skazkids-${timestamp}.dump"
temporary_path="${archive_path}.tmp"
checksum_path="${archive_path}.sha256"

cleanup() {
  rm -f "${temporary_path}"
}
trap cleanup EXIT

umask 077

/usr/lib/postgresql/17/bin/pg_dump \
  --format=custom \
  --compress=9 \
  --no-owner \
  --no-acl \
  --dbname=skazkids \
  --file="${temporary_path}"

/usr/lib/postgresql/17/bin/pg_restore --list "${temporary_path}" > /dev/null
mv "${temporary_path}" "${archive_path}"
sha256sum "${archive_path}" > "${checksum_path}"

find "${backup_dir}" -maxdepth 1 -type f -name 'skazkids-*.dump' -mtime +14 -delete
find "${backup_dir}" -maxdepth 1 -type f -name 'skazkids-*.dump.sha256' -mtime +14 -delete
